# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to the browser

# Razorpay — Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret        # set when you create the webhook

# Razorpay Plan IDs — Dashboard > Subscriptions > Plans (create these first)
RAZORPAY_PLAN_ID_MONTHLY=plan_xxxxxxxx
RAZORPAY_PLAN_ID_ANNUAL=plan_xxxxxxxx
